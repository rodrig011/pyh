---
layout: base.njk
---
{%- set heroImg = site.hero.photo or "/images/brand/powder-wordmark.jpg" -%}
<div class="split">
  <aside class="stage" aria-label="Sofisticated pressed powder">
    <div class="stage__frame">
      <img class="stage__img is-on" data-stage-img="0" src="{{ heroImg }}" alt="Blush pressed powder stamped with the Sofisticated wordmark" width="1200" height="1500" fetchpriority="high">
      <img class="stage__img" data-stage-img="1" src="/images/brand/powder-monogram.jpg" alt="Rose pressed powder stamped with the Sofisticated monogram" width="1200" height="1500" loading="lazy">
      <img class="stage__img" data-stage-img="2" src="/images/brand/paper-wordmark.jpg" alt="Pink letterpress paper pressed with the Sofisticated wordmark" width="1200" height="1500" loading="lazy">
      <p class="stage__bar"><span>{{ site.hero.note_left }}</span><a href="{{ site.social.instagram_url }}" rel="noopener" target="_blank">{{ site.hero.note_right }}</a></p>
    </div>
  </aside>

  <main id="main" class="col">
    <header class="sheet" data-stage="0">
      {% include "partials/nav.njk" %}
      <div class="sheet__body" data-reveal>
        <h1 class="display">{{ site.hero.title }}</h1>
        <p class="lead">{{ site.hero.sentence }}</p>
        <a class="btn" href="#decode">{{ site.hero.button_text }}</a>
      </div>
    </header>

    <section class="intro" data-stage="1" aria-label="About this journal" data-reveal>
      {% for p in site.intro.paragraphs %}<p>{{ p | mdInline | safe }}</p>{% endfor %}
      <p><a class="link" href="#about">Read Sofia's letter</a></p>
    </section>

    <section class="journal" id="journal" data-stage="2" aria-labelledby="journal-title">
      <h2 class="head" id="journal-title" data-reveal>The journal</h2>
      {% for cat in collections.posts | categoriesOf %}
      <div class="rows" data-reveal>
        <p class="rows__group">{{ cat }}</p>
        <ul>
          {% for post in collections.posts %}{% if (post.data.category or "Notes") == cat %}
          <li><a class="row" href="{{ post.url }}"><span class="row__dot" aria-hidden="true"></span><span class="row__name">{{ post.data.title }}</span><time class="row__val" datetime="{{ post.date | isoDate }}">{{ post.date | postDate }}</time></a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      {% endfor %}
      <p data-reveal><a class="link" href="/blog/">Every post, with summaries</a></p>
    </section>
  </main>
</div>

<section class="decoder" id="decode" aria-labelledby="decode-title">
  <div class="decoder__in">
    <div class="decoder__head" data-reveal>
      <h2 class="head" id="decode-title">{{ site.decoder.title }}</h2>
      <p class="lead">{{ site.decoder.sentence }}</p>
    </div>
    <form class="decoder__form" data-decoder data-reveal>
      <label class="decoder__label" for="inci">Ingredient list (INCI)</label>
      <textarea id="inci" name="inci" rows="5" spellcheck="false" placeholder="Aqua, Glycerin, Niacinamide, Sodium Hyaluronate, Phenoxyethanol…"></textarea>
      <div class="decoder__actions">
        <button class="btn btn--paper" type="submit">Decode it</button>
        <span class="decoder__try">Or try a real kind of label:
          <button type="button" class="chip" data-sample="moisturizer">gel moisturizer</button>
          <button type="button" class="chip" data-sample="serum">vitamin C serum</button>
          <button type="button" class="chip" data-sample="cleanser">foaming cleanser</button>
        </span>
      </div>
    </form>
    <div class="decoder__out" data-decoder-out aria-live="polite">
      <p class="decoder__hint">Your decoded list shows up here, in label order. The first five or so ingredients usually make up most of the formula; anything after the preservative is likely under 1%.</p>
    </div>
    <noscript><p class="decoder__hint">The decoder needs JavaScript. Every ingredient it knows is explained in the journal.</p></noscript>
  </div>
</section>

<section class="letter" id="about" aria-label="A letter from Sofia">
  <div class="letter__in" data-reveal>
    {% if site.about.photo %}
    <img class="letter__portrait" src="{{ site.about.photo }}" alt="Sofia Panting" width="88" height="88" loading="lazy">
    {% else %}
    <img class="letter__portrait" src="/images/brand/avatar.jpg" alt="" width="88" height="88" loading="lazy">
    {% endif %}
    <div class="letter__text">{{ site.about.letter | md | safe }}</div>
    <p class="letter__sign">{{ site.about.name }}</p>
    <p class="letter__role">{{ site.about.role }}</p>
  </div>
</section>

{% if site.instagram.images and site.instagram.images.length %}
<section class="gallery" aria-labelledby="ig-title">
  <div class="gallery__head" data-reveal>
    <h2 class="head" id="ig-title">{{ site.instagram.title }}</h2>
    <a class="link" href="{{ site.social.instagram_url }}" rel="noopener" target="_blank">{{ site.social.instagram_handle }}</a>
  </div>
  <div class="gallery__row" tabindex="0" aria-label="Instagram pictures, scroll sideways">
    {% for img in site.instagram.images %}
    <a class="gallery__item gallery__item--{{ loop.index0 % 3 }}" href="{{ site.social.instagram_url }}" rel="noopener" target="_blank">
      <img src="{{ img.src }}" alt="{{ img.alt or 'Sofisticated on Instagram' }}" loading="lazy" width="1200" height="1500">
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="cta" id="lab-notes" aria-labelledby="nl-title">
  <img class="cta__img" src="/images/brand/velvet-monogram.jpg" alt="Aubergine velvet pressed with the Sofisticated monogram" width="1200" height="1500" loading="lazy">
  <div class="cta__text" data-reveal>
    <h2 class="head" id="nl-title">{{ site.newsletter.title }}</h2>
    <p>{{ site.newsletter.subtitle }}</p>
    {% include "partials/newsletter-form.njk" %}
  </div>
</section>

{% include "partials/footer.njk" %}
<script src="/js/decoder.js" defer></script>
