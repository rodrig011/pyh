<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} · Cosmetic chemistry by Sofia Panting{% endif %}</title>
{%- set pageDescription = (excerpt or description or site.hero.sentence) | oneLine %}
{%- set pageImage = meta.url + "/images/og-share.jpg" %}
{%- if image %}{% set pageImage = image if image.startsWith("http") else meta.url + image %}{% endif %}
<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="{{ meta.author }}">
<meta name="theme-color" content="#f3c6cd">
<link rel="canonical" href="{{ meta.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="en_US">
<meta property="og:type" content="{% if '/posts/' in page.url %}article{% else %}website{% endif %}">
{%- if '/posts/' in page.url %}
<meta property="article:published_time" content="{{ page.date | isoDate }}">
<meta property="article:author" content="{{ meta.author }}">
{%- endif %}
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ meta.url }}{{ page.url }}">
<meta property="og:image" content="{{ pageImage }}">
{%- if not image %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/jpeg">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.title }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ pageImage }}">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/svg+xml" href="/images/brand/monogram.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ meta.url }}/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Italiana&family=Hanken+Grotesk:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
<script>document.documentElement.classList.add("js")</script>
{%- if '/posts/' in page.url %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ pageDescription | dump | safe }},
  "image": {{ pageImage | dump | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "author": { "@type": "Person", "name": "{{ meta.author }}", "url": "{{ meta.url }}/#about" },
  "publisher": { "@type": "Organization", "name": "{{ site.title }}", "logo": { "@type": "ImageObject", "url": "{{ meta.url }}/icon-512.png" } },
  "mainEntityOfPage": "{{ meta.url }}{{ page.url }}"
}
</script>
{%- endif %}
</head>
<body data-text-size="{{ site.text_size or 'normal' }}">
<a class="skip" href="#main">Skip to content</a>
{{ content | safe }}
<script src="/js/site.js" defer></script>
</body>
</html>
