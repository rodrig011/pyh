---
layout: base.njk
title: The journal
description: "Every post on ingredients, formulation and skin science, from Sofisticated by Sofia Panting."
permalink: /blog/
---
<div class="split">
  <aside class="stage">
    <div class="stage__frame">
      <img class="stage__img is-on" src="/images/brand/powder-monogram.jpg" alt="Rose pressed powder stamped with the Sofisticated monogram" width="1200" height="1500" fetchpriority="high">
      <p class="stage__bar"><span>{{ collections.posts.length }} posts</span><a href="/feed.xml">RSS feed</a></p>
    </div>
  </aside>
  <main id="main" class="col">
    <header class="sheet sheet--short">
      {% include "partials/nav.njk" %}
      <div class="sheet__body" data-reveal>
        <h1 class="display">The journal</h1>
        <p class="lead">Ingredients, formulas and products, explained by a chemical engineering student.</p>
      </div>
    </header>
    {% for cat in collections.posts | categoriesOf %}
    <section class="archive" aria-labelledby="cat-{{ loop.index }}" data-reveal>
      <h2 class="archive__cat" id="cat-{{ loop.index }}">{{ cat }}</h2>
      {% for post in collections.posts %}{% if (post.data.category or "Notes") == cat %}
      <a class="entry" href="{{ post.url }}">
        <span class="entry__title">{{ post.data.title }}</span>
        <span class="entry__text">{{ post.data.excerpt }}</span>
        <span class="entry__meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | postDateFull }}</time> · {{ post.templateContent | readTime }} read</span>
      </a>
      {% endif %}{% endfor %}
    </section>
    {% endfor %}
  </main>
</div>
{% include "partials/footer.njk" %}
