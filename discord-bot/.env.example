# ============================================================
#  BOT 1 — VIP memberships paid with Zelle
# ============================================================
VIP_BOT_TOKEN=
VIP_CLIENT_ID=
VIP_GUILD_ID=

# Roles to grant (right click the role > Copy ID, with developer mode on)
ROLE_TIER_1=
ROLE_TIER_2=
ROLE_TIER_3=

# Prices in dollars
TIER_1_PRICE=50
TIER_2_PRICE=100
TIER_3_PRICE=200

# Details shown to the buyer so they can send the Zelle payment
ZELLE_RECIPIENT=payments@yourdomain.com
ZELLE_RECIPIENT_NAME=Your Name

# Channel where the bot logs every payment (optional but recommended)
VIP_LOG_CHANNEL_ID=
# Roles allowed to use /vip-admin on top of anyone with "Manage Roles" (optional)
VIP_ADMIN_ROLE_IDS=

# Behaviour
ORDER_TTL_HOURS=48          # how long an unpaid code stays valid
AMOUNT_TOLERANCE=0          # accepted shortfall in dollars (0 = exact amount)
UPGRADE_ON_OVERPAY=true     # paying 200 on a tier 1 order grants tier 3
CODE_PREFIX=VIP
CODE_LENGTH=6
STORE_PATH=data/store.json
DEPLOY_COMMANDS_ON_START=true
LOG_LEVEL=info

# --- Automatic payment detection: mailbox that receives the Zelle alerts ---
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@gmail.com
IMAP_PASSWORD=                    # app password, NOT your normal password
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
IMAP_SINCE_DAYS=3
IMAP_MARK_SEEN=true
# Very important: only emails from these senders are trusted.
IMAP_ALLOWED_SENDERS=alerts@notify.wellsfargo.com,no.reply.alerts@chase.com,email.zellepay.com

# ============================================================
#  BOT 2 — Photos-only channel
# ============================================================
PHOTO_BOT_TOKEN=
PHOTO_ONLY_CHANNEL_IDS=            # comma-separated IDs
PHOTO_ONLY_ALLOW_CAPTIONS=false    # false = not a single word next to the photo
PHOTO_ONLY_ALLOW_VIDEOS=false
PHOTO_ONLY_ALLOW_LINKS=false       # false = image links get deleted too
PHOTO_ONLY_IGNORE_BOTS=true
PHOTO_ONLY_BYPASS_ROLE_IDS=        # roles allowed to post text (moderators)
PHOTO_ONLY_WARN=true
PHOTO_ONLY_WARN_SECONDS=8
PHOTO_ONLY_LOG_CHANNEL_ID=
