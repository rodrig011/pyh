# ============================================================
#  BOT 1 — VIP memberships paid with Zelle
# ============================================================
VIP_BOT_TOKEN=
VIP_CLIENT_ID=
VIP_GUILD_ID=

# Profile picture and name applied by `npm run avatar` (username is optional)
VIP_BOT_AVATAR=assets/avatar-512.png
VIP_BOT_USERNAME=King T Parlays

# Roles to grant (right click the role > Copy ID, with developer mode on)
ROLE_TIER_1=
ROLE_TIER_2=
ROLE_TIER_3=

# Prices in dollars
TIER_1_PRICE=50
TIER_2_PRICE=100
TIER_3_PRICE=200

# What each tier is called and what it includes. Optional — the bot ships with
# this copy built in. Separate the bullet lines with "|". Discord markdown works.
TIER_1_LABEL=Signals
TIER_2_LABEL=VIP
TIER_3_LABEL=Elite
# TIER_1_PERKS=📈 **Every signal, as it drops**|🔔 Entries, exits and the reasoning
# TIER_2_PERKS=✅ Everything in Signals, plus:|💬 **The VIP room**
# TIER_3_PERKS=✅ Everything in VIP, plus:|🎓 **Private lessons**|📞 **Calls with the elites**

# Details shown to the buyer. Zelle and Venmo work the same way: one payment,
# identified by the code in the note. Leave one empty and it is offered as
# "coming soon" instead of being listed as a way to pay.
ZELLE_RECIPIENT=payments@yourdomain.com
ZELLE_RECIPIENT_NAME=Your Name
VENMO_RECIPIENT=                  # e.g. @your-handle
VENMO_RECIPIENT_NAME=

# Channel where the bot logs every payment (optional but recommended)
VIP_LOG_CHANNEL_ID=
# Roles allowed to use /vip-admin. Once set, ONLY these roles (plus anyone with
# Administrator) can confirm payments, revoke memberships or cancel orders.
# They are also the roles pinged on payments and inside tickets.
VIP_MOD_ROLE_IDS=
PING_MODS_ON_PAYMENT=true
# Category the private ticket channels are created under (optional)
TICKET_CATEGORY_ID=
# DM every new member the storefront when they join
WELCOME_DM=true
# Payments arriving with no VIP code are assumed to be personal transfers and
# are never posted to Discord. Turn on only if you want to see them.
LOG_UNMATCHED_PAYMENTS=false

# --- Membership: every payment buys this many days ---
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_REMINDER_DAYS=3,1   # DM the member this many days before it ends
SUBSCRIPTION_GRACE_DAYS=0        # extra days before the roles come off
SWEEP_INTERVAL_MINUTES=15        # how often to check for expiries

# Behaviour
ORDER_TTL_HOURS=48          # how long an unpaid code stays valid
AMOUNT_TOLERANCE=0          # accepted shortfall in dollars (0 = exact amount)
UPGRADE_ON_OVERPAY=true     # paying 200 on a tier 1 order grants tier 3
CODE_PREFIX=VIP
CODE_LENGTH=6
STORE_PATH=data/store.json
DEPLOY_COMMANDS_ON_START=true
LOG_LEVEL=info

# --- Card payments (Stripe). Zelle is a one-off; Stripe bills automatically ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=              # sk_live_... (or sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=          # whsec_... from the webhook endpoint you create
STRIPE_WEBHOOK_PATH=/stripe/webhook
STRIPE_CURRENCY=usd
# Where Stripe sends the buyer after paying (defaults to your Discord server)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Automatic payment detection: mailbox that receives the Zelle alerts ---
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@gmail.com
IMAP_PASSWORD=                    # app password, NOT your normal password
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
IMAP_SINCE_DAYS=3
IMAP_MARK_SEEN=true
# Which notification emails to read
PAYMENT_PROVIDERS=zelle,venmo
# Very important: only emails from these senders are trusted. Zelle has no safe
# default because every bank differs — open a real alert and copy the sender.
IMAP_ALLOWED_SENDERS=alerts@notify.wellsfargo.com,no.reply.alerts@chase.com,email.zellepay.com
# Venmo already defaults to venmo@venmo.com; override only if yours differs.
VENMO_ALLOWED_SENDERS=

# ============================================================
#  BOT 2 — Photos-only channel
# ============================================================
PHOTO_BOT_TOKEN=
PHOTO_BOT_AVATAR=assets/avatar-512.png
PHOTO_BOT_USERNAME=
PHOTO_ONLY_CHANNEL_IDS=            # comma-separated IDs
PHOTO_ONLY_ALLOW_CAPTIONS=false    # false = not a single word next to the photo
PHOTO_ONLY_ALLOW_VIDEOS=false
PHOTO_ONLY_ALLOW_LINKS=false       # false = image links get deleted too
PHOTO_ONLY_IGNORE_BOTS=true
PHOTO_ONLY_BYPASS_ROLE_IDS=        # roles allowed to post text (moderators)
PHOTO_ONLY_WARN=true
PHOTO_ONLY_WARN_SECONDS=8
PHOTO_ONLY_LOG_CHANNEL_ID=
