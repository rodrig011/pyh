# ============================================================
#  BOT 1 — VIP memberships paid with Zelle
# ============================================================
VIP_BOT_TOKEN=
VIP_CLIENT_ID=
VIP_GUILD_ID=

# Profile picture and name applied by `npm run avatar` (username is optional)
VIP_BOT_AVATAR=assets/avatar-512.png
VIP_BOT_USERNAME=The Playbook BTC 15 min
# Name shown on the storefront and the welcome DM
VIP_BRAND_NAME=The Playbook BTC 15 min

# Roles to grant (right click the role > Copy ID, with developer mode on).
# Leave ROLE_TIER_2 and ROLE_TIER_3 empty to sell only Tier 1 — a tier with no
# role is never offered for sale.
ROLE_TIER_1=
ROLE_TIER_2=
ROLE_TIER_3=

# Prices in dollars
TIER_1_PRICE=100
TIER_2_PRICE=100
TIER_3_PRICE=200

# What each tier is called and what it includes. Optional — the bot ships with
# this copy built in. Separate the bullet lines with "|". Discord markdown works.
TIER_1_LABEL=Signals
TIER_2_LABEL=VIP
TIER_3_LABEL=Elite
# TIER_1_PERKS=📈 **Every signal, as it drops**|🔔 Entries, exits and the reasoning
# TIER_2_PERKS=✅ Everything in Signals, plus:|💬 **The VIP room**
# TIER_3_PERKS=✅ Everything in VIP, plus:|🎓 **Private lessons**|📞 **Calls with the elites**

# Details shown to the buyer. Zelle and Venmo work the same way: one payment,
# identified by the code in the note. Leave one empty and it is offered as
# "coming soon" instead of being listed as a way to pay.
ZELLE_RECIPIENT=payments@yourdomain.com
ZELLE_RECIPIENT_NAME=Your Name
VENMO_RECIPIENT=                  # e.g. @your-handle
VENMO_RECIPIENT_NAME=
CASHAPP_RECIPIENT=                 # $cashtag — checked by a mod, not automatic
CASHAPP_RECIPIENT_NAME=

# Channel where the bot logs every payment (optional but recommended)
VIP_LOG_CHANNEL_ID=
# Specific people banned on sight, by Discord user id (comma-separated). They
# are banned the moment they join, and the mod channel above is told first.
BAN_USER_IDS=
# The team the revenue is split between, evenly, on every real payment. See
# /vip-admin wallet. Comma-separated Discord user ids; leave empty to use the
# built-in roster.
TEAM_MEMBER_IDS=
# Roles allowed to use /vip-admin. Once set, ONLY these roles (plus anyone with
# Administrator) can confirm payments, revoke memberships or cancel orders.
# They are also the roles pinged on payments and inside tickets.
VIP_MOD_ROLE_IDS=
PING_MODS_ON_PAYMENT=true
# Category the private ticket channels are created under (optional)
TICKET_CATEGORY_ID=
# DM every new member the storefront when they join
WELCOME_DM=true
# Invite handed to anyone who buys before they have joined. Also the link to put
# on a poster: Discord refuses a DM between strangers, so this is what turns
# "DM the bot" into something a stranger can actually do.
SERVER_INVITE_URL=
# Answer anyone who writes to the bot in a DM with the storefront and the invite.
# The cooldown stops a stranger who types three messages getting three replies.
DM_AUTO_REPLY=true
DM_REPLY_COOLDOWN_HOURS=24
# Payments arriving with no VIP code are assumed to be personal transfers and
# are never posted to Discord. Turn on only if you want to see them.
LOG_UNMATCHED_PAYMENTS=false

# --- Membership: every payment buys this many days ---
# For a lifetime membership (one payment, never expires), set this to
# something effectively forever, e.g. 36500 (100 years) — there is no separate
# "lifetime" flag, a membership that never comes due needs no special case.
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_REMINDER_DAYS=3,1   # DM the member this many days before it ends
SUBSCRIPTION_GRACE_DAYS=0        # extra days before the roles come off
SWEEP_INTERVAL_MINUTES=15        # how often to check for expiries

# Behaviour
ORDER_TTL_HOURS=48          # how long an unpaid code stays valid
AMOUNT_TOLERANCE=0          # accepted shortfall in dollars (0 = exact amount)
# Most bank alerts do not repeat the memo, so the code never reaches the bot.
# When that happens, a payment is applied to the ONE pending order waiting for
# that exact amount, if it was placed within the window below. Two orders at the
# same price, or none at all, are never guessed: those go to the mods (or are
# ignored as a personal transfer).
MATCH_BY_AMOUNT=true
AMOUNT_MATCH_WINDOW_MINUTES=180
UPGRADE_ON_OVERPAY=true     # paying 200 on a tier 1 order grants tier 3
CODE_PREFIX=VIP
CODE_LENGTH=6
STORE_PATH=data/store.json
DEPLOY_COMMANDS_ON_START=true
LOG_LEVEL=info

# --- Card payments (Stripe). Zelle is a one-off; Stripe bills automatically ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=              # sk_live_... (or sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=          # whsec_... from the webhook endpoint you create
STRIPE_WEBHOOK_PATH=/stripe/webhook
STRIPE_CURRENCY=usd
# Where Stripe sends the buyer after paying (defaults to your Discord server)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Automatic payment detection: mailbox that receives the Zelle alerts ---
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@gmail.com
IMAP_PASSWORD=                    # app password, NOT your normal password
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
IMAP_SINCE_DAYS=3
IMAP_MARK_SEEN=true
# Which notification emails to read
PAYMENT_PROVIDERS=zelle,venmo
# Very important: only emails from these senders are trusted. Zelle has no safe
# default because every bank differs — open a real alert and copy the sender.
IMAP_ALLOWED_SENDERS=alerts@notify.wellsfargo.com,no.reply.alerts@chase.com,email.zellepay.com
# Venmo already defaults to venmo@venmo.com; override only if yours differs.
VENMO_ALLOWED_SENDERS=

# --- Trading calls: /call, /picks board, /picks record ---
PICKS_CHANNEL_ID=              # where calls are posted (defaults to the channel used)
PICKS_ANALYST_ROLE_IDS=        # roles allowed to post calls (mods always can)
PICKS_DEFAULT_MINUTES=15
PICKS_DEFAULT_ASSET=BTC
PICKS_BOARD_MINIMUM=5          # graded calls needed before the leaderboard ranks you
# Roles pinged on every call. Defaults to whichever ROLE_TIER_n are set, so the
# people paying for signals are the ones who get them.
PICKS_PING_ROLE_IDS=
PICKS_DISCLAIMER=Not financial advice
# Repost the console under the channel after a call closes, so the next signal
# is never fifty messages away from the button that sends it.
PICKS_REPOST_PANEL=true
# Hours of silence in the picks channel before staff get nudged in the log
# channel. 0 (default) is off.
PICKS_STALE_HOURS=0

# --- Sports parlays: /parlay post, /parlay board (manually graded, no live feed) ---
PARLAY_CHANNEL_ID=             # defaults to the channel /parlay post was run in
# The chat that gets the one-line version of each call and each exit, and where
# the room is asked whether they made money.
PICKS_ANNOUNCE_CHANNEL_ID=
# Where the vote result is published (defaults to PICKS_CHANNEL_ID).
PICKS_RESULT_CHANNEL_ID=
PICKS_VOTE_MINUTES=20
# Roles tagged when the room is asked how a call went. Defaults to tier 2 and 3:
# tier 1 bought signals, not a seat in the chat.
PICKS_VOTE_PING_ROLE_IDS=

# --- Kalshi: score the contract instead of BTC spot ---
# A scalp is a contract trade — bought at 47c, sold at 61c — so spot answers the
# wrong question. Leave OFF until /picks kalshi confirms the feed works.
KALSHI_ENABLED=false
KALSHI_SERIES_TICKER=          # the BTC series you trade, e.g. KXBTCD
KALSHI_SIDE=yes                # which side of the contract is being priced
KALSHI_API_BASE=               # override only if Kalshi moves the endpoint
KALSHI_API_KEY_ID=             # also the key id for the account connection below

# --- Reading the analyst's own Kalshi account (optional) ---
# Turns the track record from "what he says he did" into "what the exchange saw
# him do". The bot only ever signs /portfolio/fills, /portfolio/positions and
# /portfolio/balance — it cannot place, change or cancel an order. The key
# itself CAN trade, so it belongs here and never in the repository.
KALSHI_PRIVATE_KEY=            # the PEM. Newlines may be written as \n
KALSHI_AUTO_PUBLISH=false      # publish his fills as calls automatically
KALSHI_POLL_SECONDS=3          # how fast the room hears about a fill
KALSHI_ANALYST_DISCORD_ID=     # whose record these calls belong to
KALSHI_ANALYST_TAG=

# Live trading (real money, armed only by /picks arm in Discord — never by an
# env var). KALSHI_TRADING_KEY_ID, KALSHI_TRADING_PRIVATE_KEY, KALSHI_TRADING_OWNER_ID
# and KALSHI_DAILY_LIMIT live only in Railway, not here.
# 'careful' (default) or 'scalp' — see PROFILES in src/picks/paper.js. 'scalp'
# trades on a thinner edge and bets bigger; the daily dollar cap and circuit
# breaker apply exactly the same either way.
KALSHI_TRADING_PROFILE=careful

# A minimum ACTIVITY floor, OFF by default (0). If set, and fewer than this
# many live orders were placed in the trailing KALSHI_FORCE_WINDOW_HOURS, the
# bot forces an entry on the least-bad contract on the board even with no
# edge. This is not a strategy — Kalshi's fee makes a no-edge trade a loss on
# average, every time — it exists only because it was asked for explicitly.
# The daily cap and per-trade cap above still apply to a forced trade exactly
# as they apply to a real one. See src/picks/forceTrade.js.
KALSHI_FORCE_TRADES_PER_WINDOW=0
KALSHI_FORCE_WINDOW_HOURS=6
KALSHI_FORCE_TRADE_DOLLARS=2

# ============================================================
#  BOT 3 — Signal engine (optional, its own application)
# ============================================================
# Separate from the VIP bot on purpose: one handles money and access, the other
# has opinions about markets, and neither should be able to take the other down.
SIGNAL_BOT_TOKEN=
SIGNAL_BOT_CLIENT_ID=
SIGNAL_GUILD_ID=               # defaults to VIP_GUILD_ID
SIGNAL_CHANNEL_ID=
SIGNAL_ASSET=BTC
SIGNAL_SERIES_TICKER=          # defaults to KALSHI_SERIES_TICKER
# Every 15-minute series to scan: "BTC:KXBTC15M,ETH:KXETH15M,BNB:KXBNB15M".
# This is the honest growth lever. The edge per bet is capped by the maths; the
# number of good bets a day is not. One asset offers 96 markets a day, four
# offer nearly four hundred.
SIGNAL_MARKETS=
# The most of the bankroll at risk across simultaneous signals. Crypto moves
# together, so three parallel crypto bets are closer to one big bet than three
# small ones — this cap is what makes scanning more markets safe.
SIGNAL_MAX_TOTAL_FRACTION=0.15
# Posting stays OFF until the engine has earned it. Watch it call markets in a
# mods-only channel for a few weeks first — /engine shows whether it is any good.
SIGNAL_AUTO_POST=false
# How often the live loop asks "now?". A scalp signal is worth less every second
# it is late, and one small read is cheap.
SIGNAL_TICK_SECONDS=5
SIGNAL_PING_ROLE_IDS=
# Sizing. A quarter of Kelly on the pessimistic probability: full Kelly is only
# correct if the probability is exactly right, and it never is.
SIGNAL_KELLY_FRACTION=0.25
SIGNAL_MAX_FRACTION=0.1
# How much the model must beat the market by before it says anything. Six is
# roughly 1.5x the noise in the volatility estimate itself — below that the
# engine is trading its own measurement error and paying two fees to do it.
SIGNAL_MIN_EDGE_CENTS=6
SIGNAL_MIN_WORST_EDGE_CENTS=2
SIGNAL_MAX_SPREAD_CENTS=3
SIGNAL_MIN_LIQUIDITY=25

# Price history for the engine. Runs inside the VIP bot too, so the collecting
# starts even before the signal bot exists.
SIGNALS_COLLECT=true
SIGNALS_SAMPLE_SECONDS=30
SIGNALS_FLUSH_EVERY=10

# ============================================================
#  BOT 2 — Photos-only channel
# ============================================================
PHOTO_BOT_TOKEN=
PHOTO_BOT_AVATAR=assets/avatar-512.png
PHOTO_BOT_USERNAME=
PHOTO_ONLY_CHANNEL_IDS=            # comma-separated IDs
PHOTO_ONLY_ALLOW_CAPTIONS=true     # true = a photo may carry a caption; false = not a single word next to it
PHOTO_ONLY_ALLOW_VIDEOS=false
PHOTO_ONLY_ALLOW_LINKS=false       # false = image links get deleted too
PHOTO_ONLY_IGNORE_BOTS=true
PHOTO_ONLY_BYPASS_ROLE_IDS=        # roles allowed to post text (moderators)
PHOTO_ONLY_BYPASS_USER_IDS=        # named people allowed to post text, whatever roles they have
PHOTO_ONLY_WARN=true
PHOTO_ONLY_WARN_SECONDS=8
PHOTO_ONLY_LOG_CHANNEL_ID=
