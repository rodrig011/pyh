# ============================================================
#  BOT 1 — VIP con pagos por Zelle
# ============================================================
VIP_BOT_TOKEN=
VIP_CLIENT_ID=
VIP_GUILD_ID=

# Roles que se otorgan (click derecho en el rol > Copiar ID, con modo desarrollador activo)
ROLE_TIER_1=
ROLE_TIER_2=
ROLE_TIER_3=

# Precios en dolares
TIER_1_PRICE=50
TIER_2_PRICE=100
TIER_3_PRICE=200

# Datos que se le muestran al comprador para que envie el Zelle
ZELLE_RECIPIENT=pagos@tudominio.com
ZELLE_RECIPIENT_NAME=Nombre Apellido

# Canal donde el bot deja el registro de pagos (opcional pero recomendado)
VIP_LOG_CHANNEL_ID=
# Roles que pueden usar /vip-admin ademas de quien tenga "Gestionar roles" (opcional)
VIP_ADMIN_ROLE_IDS=

# Comportamiento
ORDER_TTL_HOURS=48          # cuanto vive un codigo sin pagar
AMOUNT_TOLERANCE=0          # margen aceptado en dolares (0 = monto exacto)
UPGRADE_ON_OVERPAY=true     # si paga 200 con orden de tier 1, se le da tier 3
CODE_PREFIX=VIP
CODE_LENGTH=6
STORE_PATH=data/store.json
DEPLOY_COMMANDS_ON_START=true
LOG_LEVEL=info

# --- Deteccion automatica del pago: buzon donde llegan los avisos de Zelle ---
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=tucorreo@gmail.com
IMAP_PASSWORD=                    # contrasena de aplicacion, NO tu contrasena normal
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
IMAP_SINCE_DAYS=3
IMAP_MARK_SEEN=true
# Muy importante: solo se confia en correos que vengan de estos remitentes.
IMAP_ALLOWED_SENDERS=alerts@notify.wellsfargo.com,no.reply.alerts@chase.com,email.zellepay.com

# ============================================================
#  BOT 2 — Canal de solo fotos
# ============================================================
PHOTO_BOT_TOKEN=
PHOTO_ONLY_CHANNEL_IDS=            # IDs separados por coma
PHOTO_ONLY_ALLOW_CAPTIONS=false    # false = ni una palabra junto a la foto
PHOTO_ONLY_ALLOW_VIDEOS=false
PHOTO_ONLY_ALLOW_LINKS=false       # false = los enlaces a imagenes tambien se borran
PHOTO_ONLY_IGNORE_BOTS=true
PHOTO_ONLY_BYPASS_ROLE_IDS=        # roles que pueden escribir texto (moderadores)
PHOTO_ONLY_WARN=true
PHOTO_ONLY_WARN_SECONDS=8
PHOTO_ONLY_LOG_CHANNEL_ID=
